{
  "expo": {
    "name": "GotujTo",
    "description": "Kulinarne inspiracje dopasowane do promocji i Twojej lodówki.",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/gotujto-mark.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/brand/gotujto-mark.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/brand/gotujto-mark.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/brand/gotujto-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gotujto.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/gotujto-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-image-picker",
      "expo-notifications",
      "expo-video",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1a78164-e810-4a52-b39e-08d48eacd01c"
      }
    },
    "owner": "szymson99"
  }
}
